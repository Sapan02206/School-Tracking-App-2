{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/send-attendance-email",
      "dest": "server.js"
    },
    {
      "src": "/send-exam-schedule-email",
      "dest": "server.js"
    },
    {
      "src": "/send-result-upload-email",
      "dest": "server.js"
    },
    {
      "src": "/send-new-student-email",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
